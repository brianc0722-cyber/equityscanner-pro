# EquityScanner Pro - Environment Variables
# Copy this file to .env and fill in your values

# === Data Providers (leave empty for full demo mode) ===
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# === Infrastructure ===
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Optional ===
# FINBERT_MODEL=ProsusAI/finbert
# PREMARKET_MODEL_PATH=/tmp/premarket_model.joblib
